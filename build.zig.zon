.{
    // Project name and version
    .name = .imgui_mach_module,
    .version = "0.1.0",

    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*. This allows
    // unambiguous detection of one package being an updated version of
    // another.
    //
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .fingerprint = 0x3033c36141b0d886, // Changing this has security and trust implications.

    // The Mach nominated version our project targets.
    // https://machengine.org/docs/zig-version
    .mach_zig_version = "2026.10.22-mach",

    // Specifies the set of files and directories that are included in this package.
    // As a rule of thumb, one should list files required for compilation plus any license(s).
    // Paths are relative to the build root. Empty string (`""`) refer to the build root itself.
    // A directory listed here means that all files within, recursively, are included.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },

    .dependencies = .{
        .mach = .{
            .url = "https://pkg.hexops.org/pkg/hexops/mach/a469b84aec8e3fe0442b26ded627bbc45c0ae3c8.tar.gz",
            .hash = "mach-0.5.0-jXwHfeasNQDSaRPz9cOxZFiLru28xhoGikKTC1BgVtZO",
        },
        .imgui = .{
            .url = "git+https://github.com/ocornut/imgui.git?ref=docking#cf53467ab0db7a783f04b32dd9160e6aa5b720ef",
            .hash = "N-V-__8AAENtiQCE4ImgddGQoxMGYleiieGLRrJ_2ciNDgMk",
        },
        .cimgui = .{
            .url = "git+https://github.com/cimgui/cimgui.git#2a6a93fccd10f275ee9206167dc9698f6f00fac1",
            .hash = "N-V-__8AAA14OwAnjBemy4fwO1a3Zbixy5gSLW2fyME4iPJn",
        },

        // Dependency for example
        .font_awesome = .{
            .url = "git+https://github.com/FortAwesome/Font-Awesome.git#14c65a3747d0f3b751f15831fc719236aea8729d",
            .hash = "N-V-__8AANd0MgQ6o7V1XdRbv4sSDqF_MuaMhQTqhYXNemx0",
        },
    },
}
